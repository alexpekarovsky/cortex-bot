# =============================================================================
# Cortex XSIAM MCP Server Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials
#
# For API key setup, see:
# https://docs-cortex.paloaltonetworks.com/r/Cortex-XSIAM/Cortex-XSIAM-Administrator-Guide/Get-Started-with-APIs

# =============================================================================
# REQUIRED: Cortex XSIAM API Credentials
# =============================================================================

# Your Cortex XSIAM API URL
# Format: https://api-{tenant}.xdr.{region}.paloaltonetworks.com
# Regions: us, eu, uk, sg, jp, au, ca, in, de
CORTEX_MCP_PAPI_URL=https://api-your-tenant.xdr.us.paloaltonetworks.com

# Your Cortex XSIAM API Key (the actual key value)
CORTEX_MCP_PAPI_AUTH_HEADER=your_api_key_here

# Your Cortex XSIAM API Key ID (the numeric ID)
CORTEX_MCP_PAPI_AUTH_ID=your_api_key_id_here

# =============================================================================
# OPTIONAL: MCP Transport Configuration
# =============================================================================

# Transport mode: stdio (default) or streamable-http
# - stdio: For Claude Desktop and Claude Code CLI (recommended)
# - streamable-http: For web-based MCP clients
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp

# =============================================================================
# OPTIONAL: Safety Controls
# =============================================================================

# Enable HIGH risk destructive tools (default: false for safety)
# HIGH risk tools include:
#   - isolate_endpoint: Disconnects endpoint from network
#   - terminate_process: Kills processes by name
#   - terminate_causality: Kills entire process trees
#   - quarantine_files: Quarantines files on endpoints
#   - run_script: Executes scripts on endpoints
#   - run_snippet_code_script: Runs ad-hoc code on endpoints
#
# WARNING: Only enable if you understand the risks and have proper access controls.
ENABLE_DESTRUCTIVE_TOOLS=false

# =============================================================================
# OPTIONAL: Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable uvicorn access logs for HTTP transport
LOG_ENABLE_UVICORN_ACCESS_LOGS=true

# =============================================================================
# OPTIONAL: Resource Limits
# =============================================================================

# Maximum objects to retrieve per request (for pagination)
MAX_OBJECTS_TO_RETRIEVE=50

# Maximum size of error message content in bytes
CORTEX_MCP_RESPONSE_ERROR_MAX_SIZE=1000

# =============================================================================
# OPTIONAL: Demisto SDK Configuration (for XSOAR development tools)
# =============================================================================
# The SDK tools automatically use the same credentials as above, mapped to:
#   DEMISTO_BASE_URL = CORTEX_MCP_PAPI_URL
#   DEMISTO_API_KEY = CORTEX_MCP_PAPI_AUTH_HEADER
#   XSIAM_AUTH_ID = CORTEX_MCP_PAPI_AUTH_ID
#
# To use SDK tools, install: pip install demisto-sdk
# No additional configuration required!
